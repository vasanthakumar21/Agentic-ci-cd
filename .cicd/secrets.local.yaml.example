# =============================================================================
# .cicd/secrets.local.yaml  —  COMMITTED EXAMPLE  (R6.4)
# =============================================================================
# This is the *documented template*. Copy it, drop the ".example" suffix, and
# fill in real values:
#
#     cp .cicd/secrets.local.yaml.example .cicd/secrets.local.yaml
#
# The real `secrets.local.yaml` is git-ignored (see .gitignore: `.cicd/*.local.*`)
# so secret VALUES never land in version control (R6.6).
#
# WHAT THIS FILE IS (R6.1 / R6.2):
#   A flat map of  SECRET_NAME: value  — the actual secret VALUES, keyed by the
#   names declared in `bootstrap.local.yaml` under `secrets:`.
#
# CONTRACT:
#   - Every key here MUST also appear in bootstrap.local.yaml `secrets:` (the
#     catalog) — and vice versa for required secrets. The loader (task 4.2)
#     cross-checks and fails naming any missing key (R6.5).
#   - Generated pipeline files reference these by KEY only, e.g.
#       GitHub:        ${{ secrets.ECR_REPO }}
#       Azure DevOps:  $(ECR_REPO)
#     The value is NEVER inlined, committed, or logged (R6.3 / R6.6 / R9.3).
#   - The bootstrapper pushes each value to the vendor's secret store by name.
#
# FILL ONLY what your chosen `ci_vendor` × `target_platform` axes need. Leave a
# key as an empty string ("") until you have the real value; the loader treats a
# required-but-empty value as missing and will name it.
# =============================================================================


# ---- aws-ecs target ---------------------------------------------------------
ECR_REPO: ""            # ECR repository URI
                        #   e.g. 123456789012.dkr.ecr.eu-west-2.amazonaws.com/my-service

# ---- databricks target ------------------------------------------------------
DATABRICKS_HOST: ""     # Databricks workspace URL
                        #   e.g. https://adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_TOKEN: ""    # Databricks workspace PAT (used at bootstrap/deploy time, by reference)

# ---- add more secrets as your IR / target plugin requires -------------------
# Each key added here must also be listed in bootstrap.local.yaml `secrets:`.
# Examples:
# SMT_SECRET_ID: ""     # id/name of a secret stored in a cloud secret manager
# FUNC_STORAGE: ""      # azure-functions: storage account connection string
