# =============================================================================
# client-azdo-databricks / .cicd/secrets.local.yaml  —  COMMITTED EXAMPLE (R6.4)
# =============================================================================
# Flat map of SECRET_NAME: value for THIS client only (R10.3 isolation). Every
# key here must also appear in bootstrap.local.yaml `secrets:`. Generated files
# reference these by key only ($(NAME) on Azure DevOps) — never the value
# (R6.3/R6.6). Copy to secrets.local.yaml (git-ignored) and fill real values.
# Note: NO aws-ecs secrets here — this client deploys a Databricks job, not an
# image, so its secret set is disjoint from client-github-aws (R10.3).
# =============================================================================
DATABRICKS_HOST: ""     # Databricks workspace URL
                        #   e.g. https://adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_TOKEN: ""    # Databricks workspace PAT (used at bootstrap/deploy time, by reference)
