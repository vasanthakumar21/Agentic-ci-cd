# =============================================================================
# client-github-aws / .cicd/secrets.local.yaml  —  COMMITTED EXAMPLE (R6.4)
# =============================================================================
# Flat map of SECRET_NAME: value for THIS client only (R10.3 isolation). Every
# key here must also appear in bootstrap.local.yaml `secrets:`. Generated files
# reference these by key only (${{ secrets.NAME }}) — never the value (R6.3/R6.6).
# Copy to secrets.local.yaml (git-ignored) and fill real values.
# =============================================================================
ECR_REPO: ""                # ECR repository URI
                            #   e.g. 123456789012.dkr.ecr.eu-west-2.amazonaws.com/orders-api
AWS_DEPLOY_ROLE_ARN: ""     # IAM role ARN the pipeline assumes via OIDC
                            #   e.g. arn:aws:iam::123456789012:role/gha-orders-deploy
