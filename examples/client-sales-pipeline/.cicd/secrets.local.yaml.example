# Copy to secrets.local.yaml (git-ignored) and fill with REAL values.
# Generated pipeline/IaC files reference these by KEY only — never the value.

secrets:
  # --- AWS OIDC deploy (keyless CI) — shared by all services ---
  AWS_DEPLOY_ROLE_ARN: "arn:aws:iam::<ACCOUNT_ID>:role/<PROJECT>-ci-deploy"

  # --- Lambda service ---
  LAMBDA_FUNCTION: "s3-file-check"
  LAMBDA_ALIAS: "live"
  LAMBDA_ARTIFACT_BUCKET: "<PROJECT>-<ACCOUNT_ID>-lambda-artifacts"
  LAMBDA_ARTIFACT_KEY: "lambda/sales-file-check.zip"

  # --- Step Functions service ---
  SFN_STATE_MACHINE_NAME: "sales-orchestrator"
  SFN_ROLE_ARN: "arn:aws:iam::<ACCOUNT_ID>:role/sales-orchestrator-sfn-exec"
  SFN_ARTIFACT_BUCKET: "sales-orchestrator-<ACCOUNT_ID>-sfn-artifacts"
  SFN_DEFINITION_KEY: "stepfunctions/state-machine.asl.json"
